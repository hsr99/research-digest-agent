# Copy this file to .env and fill in at least one key. All are free tiers.
# Never commit .env (it's in .gitignore). In GitHub Actions, add these as repository secrets.

# Google AI Studio: https://aistudio.google.com/apikey  (main "write" model)
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys  (fast, cheap "rank" model)
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys  (free ":free" models as a backup)
OPENROUTER_API_KEY=

# Optional: raises the GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
