# Copy this file to .env and fill in at least one key. Both are free, no credit card.
# Never commit .env (it's in .gitignore). In GitHub Actions, add these as repository secrets.

# OpenRouter: https://openrouter.ai/keys  (main provider, only ":free" models are used)
OPENROUTER_API_KEY=

# NVIDIA NIM: https://build.nvidia.com  (backup provider)
NVIDIA_API_KEY=

# Optional, local runs only: raises the GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=
